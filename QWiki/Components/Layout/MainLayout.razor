@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="layout-container">
    <aside class="sidebar @(sidebarOpen ? "open" : "")">
        <ChatHistorySidebar @ref="sidebar"
                            OnToggle="@ToggleSidebar"
                            OnConversationSelected="@LoadConversation"
                            OnNewChat="@NewChat"
                            ActiveConversationId="@activeConversationId" />
    </aside>

    <div class="main-content main-background-gradient">
        <main>
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1f5d9;</span>
</div>

@code {
    private bool sidebarOpen;
    private string activeConversationId = "";
    private ChatHistorySidebar? sidebar;

    public void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
        StateHasChanged();
    }

    public async Task RefreshSidebarAsync()
    {
        if (sidebar != null)
            await sidebar.RefreshAsync();
    }

    public void SetActiveConversation(string id)
    {
        activeConversationId = id;
        StateHasChanged();
    }

    private void LoadConversation(string conversationId)
    {
        activeConversationId = conversationId;
        Nav.NavigateTo($"/?cid={conversationId}", forceLoad: false);
    }

    private void NewChat()
    {
        activeConversationId = "";
        Nav.NavigateTo("/", forceLoad: false);
    }
}
