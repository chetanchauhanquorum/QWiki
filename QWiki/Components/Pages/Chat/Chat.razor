@page "/"
@using System.ComponentModel
@inject IChatClient ChatClient
@inject NavigationManager Nav
@inject SemanticSearch Search
@inject ChatHistoryService ChatHistory
@implements IDisposable

<PageTitle>QWiki</PageTitle>

<ChatHeader OnNewChat="@ResetConversationAsync" OnToggleSidebar="@ToggleSidebar" />

<ChatMessageList Messages="@messages" InProgressMessage="@currentResponseMessage" ConversationId="@conversationId" UserId="@userId">
    <NoMessagesContent>
        <div>Welcome to QWiki! Start asking questions about your documentation and I'll help you find the information you need.</div>
    </NoMessagesContent>
</ChatMessageList>

<div class="chat-container">
    <ChatSuggestions OnSelected="@AddUserMessageAsync" @ref="@chatSuggestions" />
    <ChatInput OnSend="@AddUserMessageAsync" @ref="@chatInput" />
</div>

@code {
    private const string SystemPrompt = @"
        You are an assistant who answers questions about information you retrieve.
        Do not answer questions about anything else.
        Use only simple markdown to format your responses.

        Use the search tool to find relevant information. When you do this, end your
        reply with citations in the special XML format:

        <citation filename='string' page_number='number' source_url='url' document_title='string'>exact quote here</citation>

        Always include the citation in your response if there are results.
        Always include the source_url attribute if it's available in the search results.
        Always include the document_title attribute if it's available in the search results.

        When multiple results cover the same topic, prefer wiki pages and documents
        over video recording transcripts, as wiki pages are typically more authoritative
        and up-to-date. Use video transcript results to supplement or when no
        wiki/document results are available on the topic.

        When results have record_type=""VIDEO"", these are from video recording transcripts.
        Mention that the information comes from a video recording and include the timestamp
        shown in brackets (e.g. [05:30]) so users know where in the video to look.
        If a source_url is available, tell the user they can open the video in SharePoint.

        The quote must be max 5 words, taken word-for-word from the search result, and is the basis for why the citation is relevant.
        Don't refer to the presence of citations; just emit these tags right at the end, with no surrounding text.
        ";

    private readonly ChatOptions chatOptions = new();
    private readonly List<ChatMessage> messages = new();
    private CancellationTokenSource? currentResponseCancellation;
    private ChatMessage? currentResponseMessage;
    private ChatInput? chatInput;
    private ChatSuggestions? chatSuggestions;
    private string conversationId = Guid.NewGuid().ToString();
    private string? conversationTitle;
    private string userId = "";
    private MainLayout? layout;

    [CascadingParameter]
    public MainLayout? Layout { get => layout; set => layout = value; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "cid")]
    public string? LoadConversationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var authState = await AuthState;
            userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value ?? "";
        }

        messages.Add(new(ChatRole.System, SystemPrompt));
        chatOptions.Tools = [AIFunctionFactory.Create(SearchAsync)];
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(LoadConversationId))
        {
            await LoadConversationAsync(LoadConversationId);
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var cid = query["cid"];

        if (!string.IsNullOrEmpty(cid) && cid != conversationId)
        {
            await InvokeAsync(async () =>
            {
                await LoadConversationAsync(cid);
                StateHasChanged();
            });
        }
        else if (string.IsNullOrEmpty(cid) && conversationTitle != null)
        {
            // "New chat" navigation — reset if we had a loaded conversation
            await InvokeAsync(async () =>
            {
                await ResetConversationAsync();
                StateHasChanged();
            });
        }
    }

    private async Task LoadConversationAsync(string id)
    {
        var conversation = await ChatHistory.GetConversationAsync(userId, id);
        if (conversation == null) return;

        CancelAnyCurrentResponse();
        messages.Clear();
        messages.Add(new(ChatRole.System, SystemPrompt));

        foreach (var msg in conversation.Messages)
        {
            var role = msg.Role == "User" ? ChatRole.User : ChatRole.Assistant;
            messages.Add(new ChatMessage(role, msg.Text));
        }

        conversationId = id;
        conversationTitle = conversation.Title;
        chatSuggestions?.Clear();
        layout?.SetActiveConversation(id);
    }

    private async Task AddUserMessageAsync(ChatMessage userMessage)
    {
        CancelAnyCurrentResponse();

        // Add the user message to the conversation
        messages.Add(userMessage);
        chatSuggestions?.Clear();
        await chatInput!.FocusAsync();

        // Set conversation title from first user message
        if (conversationTitle == null)
        {
            conversationTitle = userMessage.Text?.Length > 100
                ? userMessage.Text[..100] + "..."
                : userMessage.Text ?? "Untitled";
        }

        // Stream and display a new response from the IChatClient
        var responseText = new TextContent("");
        currentResponseMessage = new ChatMessage(ChatRole.Assistant, [responseText]);
        currentResponseCancellation = new(TimeSpan.FromMinutes(2));

        // Pass a sliding window of messages to stay within the LLM token limit.
        // Always include the system prompt (first message) plus the most recent messages.
        const int maxMessages = 10;
        var requestMessages = messages.Count <= maxMessages
            ? messages.ToArray()
            : [messages[0], .. messages[^(maxMessages - 1)..]];

        try
        {
            await foreach (var update in ChatClient.GetStreamingResponseAsync(
                requestMessages, chatOptions, currentResponseCancellation.Token))
            {
                AddMessages(messages, update, filter: c => c is not TextContent);
                responseText.Text += update.Text;
                ChatMessageItem.NotifyChanged(currentResponseMessage);
            }
        }
        catch (OperationCanceledException)
        {
            responseText.Text += "\n\n*[Response timed out or was cancelled. Please try again.]*";
            ChatMessageItem.NotifyChanged(currentResponseMessage);
        }
        catch (Exception ex)
        {
            var errorMsg = ex.Message.Contains("429") || ex.Message.Contains("RateLimitReached")
                ? "The AI service is temporarily rate-limited. Please wait a moment and try again."
                : "Something went wrong generating a response. Please try again.";
            responseText.Text += $"\n\n*[{errorMsg}]*";
            ChatMessageItem.NotifyChanged(currentResponseMessage);
        }

        // Store the final response in the conversation, and begin getting suggestions
        messages.Add(currentResponseMessage!);
        currentResponseMessage = null;
        chatSuggestions?.Update(messages);

        // Save conversation to history
        await SaveConversationAsync();
    }

    private async Task SaveConversationAsync()
    {
        var historyMessages = messages
            .Where(m => (m.Role == ChatRole.User || m.Role == ChatRole.Assistant) && !string.IsNullOrEmpty(m.Text))
            .Select(m => new ChatHistoryMessage
            {
                Role = m.Role == ChatRole.User ? "User" : "Assistant",
                Text = m.Text ?? ""
            })
            .ToList();

        if (historyMessages.Count > 0 && conversationTitle != null)
        {
            await ChatHistory.SaveConversationAsync(userId, conversationId, conversationTitle, historyMessages);
            layout?.SetActiveConversation(conversationId);
            if (layout != null) await layout.RefreshSidebarAsync();
        }
    }

    private void CancelAnyCurrentResponse()
    {
        // If a response was cancelled while streaming, include it in the conversation so it's not lost
        if (currentResponseMessage is not null)
        {
            messages.Add(currentResponseMessage);
        }

        currentResponseCancellation?.Cancel();
        currentResponseMessage = null;
    }

    private async Task ResetConversationAsync()
    {
        CancelAnyCurrentResponse();
        messages.Clear();
        messages.Add(new(ChatRole.System, SystemPrompt));
        chatSuggestions?.Clear();
        conversationId = Guid.NewGuid().ToString();
        conversationTitle = null;
        layout?.SetActiveConversation("");
        await chatInput!.FocusAsync();
    }

    private void ToggleSidebar()
    {
        layout?.ToggleSidebar();
    }

    // TODO: Needed until https://github.com/dotnet/extensions/issues/6114 is resolved, which will introduce
    // an extension method on IList<ChatMessage> for adding messages from a ChatResponseUpdate.
    private static void AddMessages(IList<ChatMessage> list, ChatResponseUpdate update, Func<AIContent, bool> filter)
    {
        var contentsList = update.Contents.Where(filter).ToList();
        if (contentsList.Count > 0)
        {
            list.Add(new(update.Role ?? ChatRole.Assistant, contentsList)
            {
                AuthorName = update.AuthorName,
                RawRepresentation = update.RawRepresentation,
                AdditionalProperties = update.AdditionalProperties,
            });
        }
    }

    [Description("Searches for information using a phrase or keyword")]
    private async Task<IEnumerable<string>> SearchAsync(
        [Description("The phrase to search for.")] string searchPhrase,
        [Description("Whenever possible, specify the filename to search that file only. If not provided, the search includes all files.")] string? filenameFilter = null)
    {
        await InvokeAsync(StateHasChanged);
        var results = await Search.SearchAsync(searchPhrase, filenameFilter, maxResults: 5);
        return results.Select(result =>
        {
            var text = result.Text.Length > 500 ? result.Text[..500] + "..." : result.Text;
            var resultXml = $"<result filename=\"{result.FileName}\" page_number=\"{result.PageNumber}\" record_type=\"{result.RecordType}\"";
            if (!string.IsNullOrEmpty(result.SourceUrl))
            {
                resultXml += $" source_url=\"{result.SourceUrl}\"";
            }
            if (!string.IsNullOrEmpty(result.DocumentTitle))
            {
                resultXml += $" document_title=\"{result.DocumentTitle}\"";
            }
            resultXml += $">{text}</result>";
            return resultXml;
        });
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        currentResponseCancellation?.Cancel();
    }
}
