@using System.Runtime.CompilerServices
@using System.Text.RegularExpressions
@using System.Linq
@using QWiki.Shared
@inject FeedbackService FeedbackService

@if (Message.Role == ChatRole.User)
{
    <div class="user-message">
        @Message.Text
    </div>
}
else if (Message.Role == ChatRole.Assistant)
{
    foreach (var content in Message.Contents)
    {
        if (content is TextContent { Text: { Length: > 0 } text })
        {
            <div class="assistant-message">
                <div>
                    <div class="assistant-message-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                        </svg>
                    </div>
                </div>
                <div class="assistant-message-header">Assistant</div>
                <div class="assistant-message-text">
                    <assistant-message markdown="@text"></assistant-message>

                    @foreach (var citation in citations ?? [])
                    {
                        <ChatCitation File="@citation.File" PageNumber="@citation.Page" Quote="@citation.Quote" SourceUrl="@citation.SourceUrl" DocumentTitle="@citation.DocumentTitle" />
                    }

                    @if (!InProgress)
                    {
                        <div class="feedback-buttons">
                            <button class="feedback-btn @(feedbackGiven == true ? "active-positive" : "")"
                                    @onclick="@(() => GiveFeedbackAsync(true))" disabled="@(feedbackGiven.HasValue)">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="feedback-icon">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V3a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282m0 0H22.5a2.25 2.25 0 0 1 0 4.5h-1.875a.75.75 0 0 0-.75.75v.008c0 .476.138.934.392 1.325.254.391.391.85.391 1.324 0 .834-.497 1.577-1.267 1.818-.77.24-1.397.758-1.648 1.51a1.5 1.5 0 0 1-1.518 1.043l-4.35-.29a2.243 2.243 0 0 1-1.174-.413l-1.576-1.126a2.25 2.25 0 0 0-1.307-.415H5.25" />
                                </svg>
                            </button>
                            <button class="feedback-btn @(feedbackGiven == false ? "active-negative" : "")"
                                    @onclick="@(() => GiveFeedbackAsync(false))" disabled="@(feedbackGiven.HasValue)">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="feedback-icon">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.498 15.25H4.372c-1.026 0-1.945-.694-2.054-1.715a12.137 12.137 0 0 1-.068-1.285c0-2.848.992-5.464 2.649-7.521C5.287 4.247 5.886 4 6.504 4h4.016a4.5 4.5 0 0 1 1.423.23l3.114 1.04a4.5 4.5 0 0 0 1.423.23h1.294M7.498 15.25c.618 0 .991.724.725 1.282A7.471 7.471 0 0 0 7.5 19.75 2.25 2.25 0 0 0 9.75 22a.75.75 0 0 0 .75-.75v-.633c0-.573.11-1.14.322-1.672.304-.76.93-1.33 1.653-1.715a9.04 9.04 0 0 0 2.86-2.4c.498-.634 1.226-1.08 2.032-1.08h.384" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        else if (content is FunctionCallContent { Name: "Search" } fcc && fcc.Arguments?.TryGetValue("searchPhrase", out var searchPhrase) is true)
        {
            <div class="assistant-search">
                <div class="assistant-search-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </div>
                <div class="assistant-search-content">
                    Searching:
                    <span class="assistant-search-phrase">@searchPhrase</span>
                    @if (fcc.Arguments?.TryGetValue("filenameFilter", out var filenameObj) is true && filenameObj is string filename && !string.IsNullOrEmpty(filename))
                    {
                        <text> in </text><span class="assistant-search-phrase">@filename</span>
                    }
                </div>
            </div>
        }
    }
}

@code {
    private static readonly ConditionalWeakTable<ChatMessage, ChatMessageItem> SubscribersLookup = new();
    private static readonly Regex CitationRegex = new(@"<citation filename='(?<file>[^']*)' page_number='(?<page>\d*)'(?: source_url='(?<sourceurl>[^']*)')?(?: document_title='(?<doctitle>[^']*)')?(?:.*?)>(?<quote>.*?)</citation>", RegexOptions.NonBacktracking);

    private List<(string File, int? Page, string Quote, string? SourceUrl, string? DocumentTitle)>? citations;
    private bool? feedbackGiven;

    [Parameter, EditorRequired]
    public required ChatMessage Message { get; set; }

    [Parameter]
    public bool InProgress { get; set; }

    [Parameter]
    public string ConversationId { get; set; } = "";

    [Parameter]
    public string? PrecedingUserQuery { get; set; }

    [Parameter]
    public string UserId { get; set; } = "";

    protected override void OnInitialized()
    {
        SubscribersLookup.AddOrUpdate(Message, this);

        if (!InProgress && Message.Role == ChatRole.Assistant && Message.Text is { Length: > 0 } text)
        {
            ParseCitations(text);
        }
    }

    public static void NotifyChanged(ChatMessage source)
    {
        if (SubscribersLookup.TryGetValue(source, out var subscriber))
        {
            subscriber.StateHasChanged();
        }
    }

    private async Task GiveFeedbackAsync(bool isPositive)
    {
        if (feedbackGiven.HasValue) return;
        feedbackGiven = isPositive;

        await FeedbackService.SaveFeedbackAsync(new FeedbackEntry
        {
            ConversationId = ConversationId,
            UserId = UserId,
            UserQuery = PrecedingUserQuery ?? "",
            AssistantResponse = Message.Text ?? "",
            IsPositive = isPositive,
            Timestamp = DateTimeOffset.UtcNow
        });
    }

    private void ParseCitations(string text)
    {
        var matches = CitationRegex.Matches(text);
        citations = matches.Any()
            ? matches.Select(m => (
                m.Groups["file"].Value,
                int.TryParse(m.Groups["page"].Value, out var page) ? page : (int?)null,
                m.Groups["quote"].Value,
                m.Groups["sourceurl"].Success ? m.Groups["sourceurl"].Value : null,
                m.Groups["doctitle"].Success && m.Groups["doctitle"].Value.Length > 0 ? m.Groups["doctitle"].Value : null
            )).ToList()
            : null;
    }
}
