{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ingestion": {
    "RunOnce": false,
    "IntervalMinutes": 60
  },
  "AzureSearch": {
    "Endpoint": "https://qwiki-search.search.windows.net"
  },
  "WikiIngestion": {
    "RootPaths": [
      "Maintenance"
    ]
  },
  "SharePointIngestion": {
    "TenantId": "",
    "ClientId": "",
    "SiteHostname": "qbsol.sharepoint.com",
    "SitePath": "/sites/MidstreamandTransportationTeam",
    "DocumentLibraryName": "Documents",
    "RootFolder": "General/Recorded Sprint Ceremonies",
    "MaxFileSizeMB": 100,
    "SupportedExtensions": [ ".pdf", ".pptx", ".docx", ".mp4", ".mkv" ]
  },
  "LocalFolderIngestion": {
    "Enabled": false,
    "FolderPath": "LocalData/SharePoint",
    "SourceUrlPrefix": "https://qbsol.sharepoint.com/sites/MidstreamandTransportationTeam/Shared Documents/General/Recorded Sprint Ceremonies",
    "SupportedExtensions": [ ".pdf", ".pptx", ".docx", ".mp4", ".mkv" ]
  },
  "AzureSpeech": {
    "Region": "eastus"
  },
  "AzureStorage": {
    "ConnectionString": ""
  }
}
